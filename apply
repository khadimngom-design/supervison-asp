    /* ========================================================================= */
    /* LEAFLET MAP INTEGRATION (SENEGAL REGIONS)                                 */
    /* ========================================================================= */
    function initLeafletMap() {
      // Center of Senegal
      leafletMap = L.map('mapSenegal').setView([14.4974, -14.4524], 7);

      // Dark Theme Map Tiles
      L.tileLayer('https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png', {
        attribution: '&copy; OpenStreetMap &copy; CARTO',
        maxZoom: 18
      }).addTo(leafletMap);

      refreshMapMarkers();
    }

    function refreshMapMarkers() {
      if (!leafletMap) return;
      // Clear old markers
      mapMarkers.forEach(m => leafletMap.removeLayer(m));
      mapMarkers = [];

      // Custom Icon Generators
      const agentIcon = L.divIcon({
        className: 'custom-div-icon',
        html: `<div style="background-color: #10b981; width: 14px; height: 14px; border-radius: 50%; border: 2px solid white; box-shadow: 0 0 8px #10b981;"></div>`,
        iconSize: [14, 14]
      });

      const incidentIcon = L.divIcon({
        className: 'custom-div-icon',
        html: `<div style="background-color: #ef4444; width: 18px; height: 18px; border-radius: 50%; border: 2px solid white; box-shadow: 0 0 12px #ef4444;" class="animate-ping"></div>`,
        iconSize: [18, 18]
      });

      // Add Agents Markers
      agentsList.forEach(ag => {
        const marker = L.marker([ag.lat, ag.lng], { icon: agentIcon })
          .addTo(leafletMap)
          .bindPopup(`
            <div class="p-1">
              <strong class="text-emerald-400">${ag.name} (${ag.id})</strong><br/>
              <span class="text-xs">Zone: ${ag.zone}</span><br/>
              <span class="text-[10px] text-slate-400">Statut: ${ag.status}</span>
            </div>
          `);
        mapMarkers.push(marker);
      });

      // Add Incidents Markers
      incidentsList.filter(i => i.status === 'EN_COURS').forEach(inc => {
        const marker = L.marker([inc.lat, inc.lng], { icon: incidentIcon })
          .addTo(leafletMap)
          .bindPopup(`
            <div class="p-1">
              <strong class="text-red-400">${inc.id} - ${inc.category}</strong><br/>
              <span class="text-xs">${inc.zone}</span><br/>
              <p class="text-[10px] text-slate-300 mt-1">${inc.desc}</p>
              <button onclick="openIncidentDetails('${inc.id}')" class="mt-2 text-[10px] bg-emerald-600 text-white px-2 py-1 rounded">Traiter Alerte</button>
            </div>
          `);
        mapMarkers.push(marker);
      });
    }

