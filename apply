    /* ========================================================================= */
    /* SIMULATEUR APPLICATION MOBILE AGENT                                       */
    /* ========================================================================= */
    function handleMobilePresence() {
      const btn = document.getElementById('btnCheckIn');
      const badge = document.getElementById('presenceBadge');
      
      btn.disabled = true;
      btn.innerHTML = `<i class="fa-solid fa-spinner animate-spin"></i> Géolocalisation GPS en cours...`;

      setTimeout(() => {
        btn.className = "w-full py-2 bg-slate-800 text-emerald-400 text-xs font-bold rounded-lg border border-emerald-500/40 flex items-center justify-center gap-2 cursor-default";
        btn.innerHTML = `<i class="fa-solid fa-circle-check"></i> Prise de Service Confirmée`;
        
        badge.className = "px-2 py-0.5 rounded-full text-[9px] bg-emerald-500/20 text-emerald-400 font-semibold border border-emerald-500/30";
        badge.innerText = "Présence Validée";

        // Update Modou Diop status in agents list
        const modou = agentsList.find(a => a.id === 'ASP-001');
        if (modou) {
          modou.status = 'Présent';
          modou.lastPing = 'À l’instant';
          renderAgentsTable();
        }

        showToast("Signalement de Présence GPS", "Votre position (Dakar-Plateau) a été transmise au Centre de Supervision.");
      }, 1200);
    }

    function showMobileModal(type) {
      if (type === 'incident') {
        document.getElementById('mobileIncidentModal').classList.remove('hidden');
      }
    }

    function closeMobileModal() {
      document.getElementById('mobileIncidentModal').classList.add('hidden');
    }

    function handleMobileSubmitIncident(e) {
      e.preventDefault();
      const cat = document.getElementById('mIncCategory').value;
      const zone = document.getElementById('mIncZone').value;
      const sev = document.getElementById('mIncSeverity').value;
      const desc = document.getElementById('mIncDesc').value;

      const newInc = {
        id: `INC-2024-0${Math.floor(Math.random() * 90 + 10)}`,
        timestamp: new Date().toLocaleDateString('fr-FR') + ' ' + new Date().toLocaleTimeString('fr-FR', {hour: '2-digit', minute:'2-digit'}),
        zone,
        category: cat,
        agent: "Modou Diop",
        severity: sev,
        status: "EN_COURS",
        desc,
        lat: 14.6937 + (Math.random() * 0.04 - 0.02),
        lng: -17.4441 + (Math.random() * 0.04 - 0.02)
      };

      incidentsList.unshift(newInc);
      renderIncidentsTable();
      refreshMapMarkers();
      closeMobileModal();

      showToast("Incident Alerte Transmis !", `L'incident ${newInc.id} est maintenant visible sur le tableau de supervision national.`);
    }

    function mobileLogout() {
      document.getElementById('mobileDashboardScreen').classList.add('hidden');
      document.getElementById('mobileLoginScreen').classList.remove('hidden');
    }

    function handleMobileLogin(e) {
      e.preventDefault();
      document.getElementById('mobileLoginScreen').classList.add('hidden');
      document.getElementById('mobileDashboardScreen').classList.remove('hidden');
      showToast("Connexion Réussie", "Bienvenue Agent Modou Diop sur l'application ASP Mobile.");
    }

    function mobileNav(target) {
      if (target === 'contacts') {
        alert("Répertoire d'urgence prêt. Pour composer un numéro d'urgence, touchez directement les raccourcis à l'écran.");
      }
    }

    /* ========================================================================= */
    /* UTILITY: TOAST NOTIFICATIONS                                             */
    /* ========================================================================= */
    function showToast(title, message) {
      const container = document.getElementById('toastContainer');
      const toast = document.createElement('div');
      toast.className = "bg-slate-900 border border-emerald-500/50 text-white p-3 rounded-xl shadow-2xl flex items-start gap-3 w-80 transform transition-all duration-300 translate-y-2 opacity-0";
      
      toast.innerHTML = `
        <div class="text-emerald-400 text-lg mt-0.5"><i class="fa-solid fa-circle-info"></i></div>
        <div class="flex-1 text-xs">
          <strong class="block font-bold text-slate-100">${title}</strong>
          <span class="text-slate-400 leading-snug">${message}</span>
        </div>
      `;

      container.appendChild(toast);

      setTimeout(() => {
        toast.classList.remove('translate-y-2', 'opacity-0');
      }, 50);

      setTimeout(() => {
        toast.classList.add('opacity-0', 'translate-y-2');
        setTimeout(() => toast.remove(), 300);
      }, 4000);
    }
  </script>
</body>
</html>
