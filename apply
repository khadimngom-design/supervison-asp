    /* MAIN VIEW TAB TOGGLER (Web Supervision vs Mobile App) */
    function switchMainTab(tabName) {
      const btnWeb = document.getElementById('tabBtnWeb');
      const btnMobile = document.getElementById('tabBtnMobile');
      const viewWeb = document.getElementById('viewWebSupervision');
      const viewMobile = document.getElementById('viewMobileAgent');

      if (tabName === 'web') {
