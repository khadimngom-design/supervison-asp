      const filtered = incidentsList.filter(item => {
        if (sevFilter !== 'ALL' && item.severity !== sevFilter) return false;
        if (statusFilter !== 'ALL' && item.status !== statusFilter) return false;
        return true;
      });

      filtered.forEach(inc => {
        const tr = document.createElement('tr');
        tr.className = "hover:bg-slate-900/60 transition";

        let sevBadge = 'bg-slate-800 text-slate-300';
        if (inc.severity === 'CRITIQUE') sevBadge = 'bg-red-500/20 text-red-400 border border-red-500/30';
        if (inc.severity === 'ELEVEE') sevBadge = 'bg-amber-500/20 text-amber-400 border border-amber-500/30';
        if (inc.severity === 'MOYENNE') sevBadge = 'bg-blue-500/20 text-blue-400 border border-blue-500/30';

        let statusBadge = inc.status === 'EN_COURS' 
          ? '<span class="px-2 py-0.5 rounded-full text-[10px] bg-amber-500/10 text-amber-400 border border-amber-500/20 flex items-center gap-1 w-fit"><span class="w-1.5 h-1.5 rounded-full bg-amber-400 animate-pulse"></span> En cours</span>'
          : '<span class="px-2 py-0.5 rounded-full text-[10px] bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 flex items-center gap-1 w-fit"><i class="fa-solid fa-check text-[8px]"></i> Résolu</span>';

        tr.innerHTML = `
          <td class="px-4 py-3 font-mono font-bold text-slate-200">${inc.id}</td>
          <td class="px-4 py-3 text-slate-400">${inc.timestamp}</td>
          <td class="px-4 py-3 font-medium text-white">${inc.zone}</td>
          <td class="px-4 py-3 text-slate-300">${inc.category}</td>
          <td class="px-4 py-3 text-emerald-400">${inc.agent}</td>
          <td class="px-4 py-3"><span class="px-2 py-0.5 rounded text-[10px] font-semibold ${sevBadge}">${inc.severity}</span></td>
          <td class="px-4 py-3">${statusBadge}</td>
          <td class="px-4 py-3 text-right">
            <button onclick="openIncidentDetails('${inc.id}')" class="px-2.5 py-1 rounded bg-slate-800 hover:bg-slate-700 text-slate-200 text-[11px] border border-slate-700 transition">
              <i class="fa-solid fa-eye"></i> Gérer
            </button>
          </td>
        `;
        tbody.appendChild(tr);
      });

      // Update KPI counter
      document.getElementById('kpiOpenIncidents').innerText = incidentsList.filter(i => i.status === 'EN_COURS').length;
      document.getElementById('kpiResolvedIncidents').innerText = incidentsList.filter(i => i.status === 'RESOLU').length;
    }

    function filterIncidentsTable() {
      renderIncidentsTable();
    }

    function openIncidentDetails(incId) {
      const inc = incidentsList.find(i => i.id === incId);
      if (!inc) return;

      activeSelectedIncidentId = incId;
      const modalBody = document.getElementById('incidentModalBody');
      const btnResolve = document.getElementById('btnResolveModal');

      modalBody.innerHTML = `
        <div class="grid grid-cols-2 gap-3 bg-slate-950 p-3 rounded-lg border border-slate-800">
          <div><span class="text-slate-500">ID Incident:</span> <strong class="text-slate-200 font-mono">${inc.id}</strong></div>
          <div><span class="text-slate-500">Date/Heure:</span> <span class="text-slate-300">${inc.timestamp}</span></div>
          <div><span class="text-slate-500">Zone:</span> <span class="text-white font-semibold">${inc.zone}</span></div>
          <div><span class="text-slate-500">Agent Référent:</span> <span class="text-emerald-400">${inc.agent}</span></div>
        </div>
        <div>
          <label class="text-slate-400 font-semibold block mb-1">Catégorie & Gravité:</label>
          <div class="flex items-center gap-2">
            <span class="px-2 py-1 rounded bg-slate-800 text-slate-200 font-medium">${inc.category}</span>
            <span class="px-2 py-1 rounded bg-red-500/20 text-red-400 border border-red-500/30">${inc.severity}</span>
          </div>
        </div>
        <div>
          <label class="text-slate-400 font-semibold block mb-1">Description détaillée du signalement:</label>
          <p class="bg-slate-950 p-3 rounded-lg border border-slate-800 text-slate-300 leading-relaxed">${inc.desc}</p>
        </div>
      `;

      if (inc.status === 'RESOLU') {
        btnResolve.classList.add('hidden');
      } else {
        btnResolve.classList.remove('hidden');
      }

      document.getElementById('incidentModal').classList.remove('hidden');
    }

    function closeIncidentModal() {
      document.getElementById('incidentModal').classList.add('hidden');
    }

    function resolveCurrentIncident() {
      if (!activeSelectedIncidentId) return;
      const inc = incidentsList.find(i => i.id === activeSelectedIncidentId);
      if (inc) {
        inc.status = 'RESOLU';
        showToast("Incident mis à jour", `L'incident ${inc.id} a été marqué comme résolu.`);
        renderIncidentsTable();
        refreshMapMarkers();
        closeIncidentModal();
      }
    }

    /* ========================================================================= */
    /* AGENTS MANAGEMENT TABLE                                                   */
    /* ========================================================================= */
    function renderAgentsTable() {
      const tbody = document.getElementById('agentsTableBody');
      tbody.innerHTML = '';

      agentsList.forEach(ag => {
        const tr = document.createElement('tr');
        tr.className = "hover:bg-slate-900/60 transition";
        tr.innerHTML = `
          <td class="px-4 py-3 font-mono font-bold text-emerald-400">${ag.id}</td>
          <td class="px-4 py-3 text-white font-medium">${ag.name}</td>
          <td class="px-4 py-3 text-slate-400">${ag.pole}</td>
          <td class="px-4 py-3 text-slate-300">${ag.zone}</td>
          <td class="px-4 py-3 font-mono text-[11px] text-slate-400">${ag.lastPing}</td>
          <td class="px-4 py-3">
            <span class="px-2.5 py-1 rounded-full text-[10px] ${ag.status === 'Présent' ? 'bg-emerald-500/20 text-emerald-400 border border-emerald-500/30' : 'bg-amber-500/20 text-amber-400'}">
              ${ag.status}
            </span>
          </td>
        `;
        tbody.appendChild(tr);
      });
    }

    function filterAgentsTable() {
      const term = document.getElementById('searchAgentInput').value.toLowerCase();
      const rows = document.querySelectorAll('#agentsTableBody tr');
      rows.forEach(row => {
        const text = row.innerText.toLowerCase();
        row.style.display = text.includes(term) ? '' : 'none';
      });
    }

    /* ========================================================================= */
    /* DIRECTIVES BROADCAST                                                      */
    /* ========================================================================= */
    function renderDirectivesList() {
      const container = document.getElementById('directivesHistoryList');
      const mobileList = document.getElementById('mobileDirectivesList');

      container.innerHTML = '';
      mobileList.innerHTML = '';

      directivesList.forEach(dir => {
        // Web Render
        const item = document.createElement('div');
        item.className = "bg-slate-950 p-4 rounded-xl border border-slate-800 space-y-2";
        item.innerHTML = `
          <div class="flex justify-between items-center">
            <h4 class="text-xs font-bold text-emerald-400 flex items-center gap-2">
              <i class="fa-solid fa-bullhorn"></i> ${dir.title}
            </h4>
            <span class="px-2 py-0.5 text-[10px] rounded bg-slate-800 text-slate-400">Cible: ${dir.target}</span>
          </div>
          <p class="text-xs text-slate-300">${dir.content}</p>
          <div class="flex justify-between items-center text-[10px] text-slate-500 pt-1 border-t border-slate-900">
            <span>Priorité: <strong class="text-amber-400">${dir.priority}</strong></span>
            <span>Diffusé le: ${dir.date}</span>
          </div>
        `;
        container.appendChild(item);

        // Mobile Render (Only latest 2)
        const mItem = document.createElement('div');
        mItem.className = "bg-slate-900 p-2.5 rounded-lg border border-slate-800 space-y-1 text-[10px]";
        mItem.innerHTML = `
          <div class="flex justify-between font-bold text-slate-200">
            <span>${dir.title}</span>
            <span class="text-amber-400 font-mono">${dir.priority}</span>
          </div>
          <p class="text-slate-400 leading-tight">${dir.content}</p>
        `;
        mobileList.appendChild(mItem);
      });
    }

    function handleSendDirective(e) {
      e.preventDefault();
      const target = document.getElementById('dirTarget').value;
      const title = document.getElementById('dirTitle').value;
      const priority = document.getElementById('dirPriority').value;
      const content = document.getElementById('dirContent').value;

      const newDir = {
        id: Date.now(),
        target,
        title,
        priority,
        date: new Date().toLocaleDateString('fr-FR') + ' ' + new Date().toLocaleTimeString('fr-FR'),
        content
      };

      directivesList.unshift(newDir);
      renderDirectivesList();
      document.getElementById('directiveForm').reset();
      showToast("Directive Diffusée", `Consigne envoyée avec succès aux terminaux de la zone [${target}].`);
    }

    /* ========================================================================= */
    /* PARTNERS & INDEMNIFICATIONS                                               */
    /* ========================================================================= */
    function renderPartnersAndIndemnities() {
      const pContainer = document.getElementById('partnersListContainer');
      pContainer.innerHTML = '';
      partnersList.forEach(p => {
        pContainer.innerHTML += `
          <div class="bg-slate-900 p-3 rounded-lg border border-slate-800 flex justify-between items-center text-xs">
            <div>
              <h5 class="font-bold text-slate-200">${p.name}</h5>
              <p class="text-[10px] text-slate-400">${p.role}</p>
            </div>
            <div class="text-right">
              <span class="px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 text-[10px]">${p.type}</span>
              <p class="text-[10px] font-mono text-slate-400 mt-1">${p.contact}</p>
            </div>
          </div>
        `;
      });

      const iContainer = document.getElementById('indemnitiesListContainer');
      iContainer.innerHTML = '';
      indemnitiesList.forEach(ind => {
        iContainer.innerHTML += `
          <div class="bg-slate-900 p-3 rounded-lg border border-slate-800 flex justify-between items-center text-xs">
            <div>
              <h5 class="font-bold text-white">${ind.agent}</h5>
              <p class="text-[10px] text-slate-400">Date d'échéance: ${ind.date}</p>
            </div>
            <div class="text-right">
              <strong class="text-emerald-400 font-mono text-sm">${ind.amount}</strong>
              <p class="text-[10px] text-slate-400">${ind.status}</p>
            </div>
          </div>
        `;
      });
    }

    /* ========================================================================= */
    /* CHART.JS ANALYTICS                                                        */
    /* ========================================================================= */
    function initCharts() {
      // 1. Incidents by Region Chart
      const ctxRegion = document.getElementById('chartIncidentsRegion').getContext('2d');
      new Chart(ctxRegion, {
        type: 'bar',
        data: {
          labels: ['Dakar', 'Thiès', 'Saint-Louis', 'Kaolack', 'Ziguinchor', 'Diourbel'],
          datasets: [{
            label: 'Incidents Signalés',
            data: [45, 28, 14, 19, 22, 11],
            backgroundColor: '#10b981',
            borderRadius: 6
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: { legend: { display: false } },
