<!DOCTYPE html>
<html lang="fr" class="h-full bg-slate-900 text-slate-100">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ASP Sénégal - Plateforme de Digitalisation & Sécurité de Proximité</title>
  
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- FontAwesome Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <!-- Leaflet CSS & JS for Maps -->
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
  <!-- Chart.js for Reports & Analytics -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <!-- Google Fonts: Inter -->
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            asp: {
              green: '#00853f',
              yellow: '#fdef42',
              red: '#e31b23',
              darkNavy: '#0f172a',
              cardNavy: '#1e293b',
              accentGreen: '#10b981',
              accentBlue: '#3b82f6'
            }
          },
          fontFamily: {
            sans: ['Inter', 'sans-serif'],
          }
        }
      }
    }
  </script>

  <style>
    /* Custom Scrollbar */
    ::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    ::-webkit-scrollbar-track {
      background: #0f172a;
    }
    ::-webkit-scrollbar-thumb {
      background: #334155;
      border-radius: 4px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: #475569;
    }

    /* Pulse animation for alert indicators */
    @keyframes pulse-fast {
      0%, 100% { opacity: 1; transform: scale(1); }
      50% { opacity: 0.4; transform: scale(1.1); }
    }
    .animate-pulse-fast {
      animation: pulse-fast 1.2s infinite ease-in-out;
    }

    /* Leaflet Map Styling Override */
    .leaflet-container {
      background-color: #0f172a !important;
      font-family: 'Inter', sans-serif;
    }
    .leaflet-popup-content-wrapper {
      background: #1e293b !important;
      color: #f8fafc !important;
      border: 1px solid #334155;
      border-radius: 8px;
    }
    .leaflet-popup-tip {
      background: #1e293b !important;
    }

    /* Senegalese Flag Accent Border */
    .senegal-bar {
      height: 4px;
      background: linear-gradient(90deg, #00853f 33.33%, #fdef42 33.33%, #fdef42 66.66%, #e31b23 66.66%);
    }

    /* Mobile Mockup Glass effect */
    .mobile-frame {
      box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.7);
    }
  </style>
</head>
<body class="h-full flex flex-col font-sans overflow-x-hidden selection:bg-emerald-500 selection:text-white">

  <!-- TOP NATIONAL BANNER & SENEGALESE FLAG ACCENT -->
  <div class="senegal-bar"></div>
  <header class="bg-slate-950 border-b border-slate-800 px-4 py-3 flex flex-wrap items-center justify-between gap-4 sticky top-0 z-50">
    <div class="flex items-center space-x-3">
      <div class="w-10 h-10 rounded-lg bg-emerald-700/20 border border-emerald-500/40 flex items-center justify-center font-bold text-emerald-400 text-xl shadow-lg">
        ASP
      </div>
      <div>
        <h1 class="text-lg font-bold tracking-wide text-slate-100 flex items-center gap-2">
          REPUBLIQUE DU SENEGAL
          <span class="text-xs font-semibold px-2 py-0.5 rounded bg-slate-800 text-emerald-400 border border-emerald-500/30">Ministère de l'Intérieur</span>
        </h1>
        <p class="text-xs text-slate-400">Agence d'Assistance à la Sécurité de Proximité • Solution Globale de Digitalisation</p>
      </div>
    </div>

    <!-- MAIN APP VIEW TOGGLER (Web Pilotage vs Mobile Simulator) -->
    <div class="flex items-center bg-slate-900 p-1 rounded-xl border border-slate-700">
      <button id="tabBtnWeb" onclick="switchMainTab('web')" 
        class="px-4 py-2 text-sm font-semibold rounded-lg transition-all flex items-center gap-2 bg-emerald-600 text-white shadow-md">
        <i class="fa-solid font-bold fa-desktop"></i>
        <span>Centre de Pilotage (Web)</span>
      </button>
      <button id="tabBtnMobile" onclick="switchMainTab('mobile')" 
        class="px-4 py-2 text-sm font-semibold rounded-lg transition-all flex items-center gap-2 text-slate-400 hover:text-white">
        <i class="fa-solid fa-mobile-screen-button"></i>
        <span>App Agent Terrain (Mobile)</span>
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
      </button>
    </div>

    <!-- Global Actions / Live Stats Badge -->
    <div class="hidden lg:flex items-center space-x-4 text-xs text-slate-300">
      <div class="flex items-center gap-2 bg-slate-900 px-3 py-1.5 rounded-lg border border-slate-800">
        <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-ping"></span>
        <span>Système d'Alerte RSN: <strong class="text-emerald-400">Opérationnel</strong></span>
      </div>
      <div class="text-slate-400" id="liveClock">--:--:--</div>
    </div>
  </header>

  <!-- MAIN VIEW CONTENT CONTAINERS -->
  <main class="flex-1 overflow-y-auto bg-slate-950 p-3 sm:p-6">

    <!-- ========================================================================= -->
    <!-- VIEW 1: CENTRE DE PILOTAGE ET SUPERVISION WEB                             -->
    <!-- ========================================================================= -->
    <div id="viewWebSupervision" class="space-y-6">

      <!-- TOP METRICS KPI CARDS -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <!-- KPI 1 -->
        <div class="bg-slate-900 border border-slate-800 rounded-xl p-4 flex items-center justify-between shadow-sm relative overflow-hidden group hover:border-slate-700 transition">
          <div class="absolute top-0 right-0 w-2 h-full bg-emerald-500"></div>
          <div>
            <p class="text-xs font-medium text-slate-400 uppercase tracking-wider">Agents ASP Déployés</p>
            <h3 class="text-2xl font-extrabold text-white mt-1" id="kpiTotalAgents">1,248</h3>
            <p class="text-xs text-emerald-400 mt-1 flex items-center gap-1">
              <i class="fa-solid fa-square-check"></i> 14 Pôles Régionaux
            </p>
          </div>
          <div class="w-12 h-12 rounded-xl bg-emerald-500/10 text-emerald-400 flex items-center justify-center text-xl border border-emerald-500/20">
            <i class="fa-solid fa-user-shield"></i>
          </div>
        </div>

        <!-- KPI 2 -->
        <div class="bg-slate-900 border border-slate-800 rounded-xl p-4 flex items-center justify-between shadow-sm relative overflow-hidden group hover:border-slate-700 transition">
          <div class="absolute top-0 right-0 w-2 h-full bg-blue-500"></div>
          <div>
            <p class="text-xs font-medium text-slate-400 uppercase tracking-wider">Agents Actifs sur le Terrain</p>
            <h3 class="text-2xl font-extrabold text-white mt-1" id="kpiActiveAgents">982</h3>
            <p class="text-xs text-blue-400 mt-1 flex items-center gap-1">
              <i class="fa-solid fa-location-dot"></i> GPS Signalé aujourd'hui
            </p>
          </div>
          <div class="w-12 h-12 rounded-xl bg-blue-500/10 text-blue-400 flex items-center justify-center text-xl border border-blue-500/20">
            <i class="fa-solid fa-walkie-talkie"></i>
          </div>
        </div>

        <!-- KPI 3 -->
        <div class="bg-slate-900 border border-slate-800 rounded-xl p-4 flex items-center justify-between shadow-sm relative overflow-hidden group hover:border-slate-700 transition">
          <div class="absolute top-0 right-0 w-2 h-full bg-amber-500"></div>
          <div>
            <p class="text-xs font-medium text-slate-400 uppercase tracking-wider">Incidents en cours</p>
            <h3 class="text-2xl font-extrabold text-amber-400 mt-1" id="kpiOpenIncidents">14</h3>
            <p class="text-xs text-amber-300/80 mt-1 flex items-center gap-1">
              <i class="fa-solid fa-triangle-exclamation"></i> Dont 3 Haute Priorité
            </p>
          </div>
          <div class="w-12 h-12 rounded-xl bg-amber-500/10 text-amber-400 flex items-center justify-center text-xl border border-amber-500/20">
            <i class="fa-solid fa-bell animate-bounce"></i>
          </div>
        </div>

        <!-- KPI 4 -->
        <div class="bg-slate-900 border border-slate-800 rounded-xl p-4 flex items-center justify-between shadow-sm relative overflow-hidden group hover:border-slate-700 transition">
          <div class="absolute top-0 right-0 w-2 h-full bg-purple-500"></div>
          <div>
            <p class="text-xs font-medium text-slate-400 uppercase tracking-wider">Incidents Résolus (Ce mois)</p>
            <h3 class="text-2xl font-extrabold text-white mt-1" id="kpiResolvedIncidents">312</h3>
            <p class="text-xs text-emerald-400 mt-1 flex items-center gap-1">
              <i class="fa-solid fa-arrow-trend-up"></i> Taux de résolution 94%
            </p>
          </div>
          <div class="w-12 h-12 rounded-xl bg-purple-500/10 text-purple-400 flex items-center justify-center text-xl border border-purple-500/20">
            <i class="fa-solid fa-circle-check"></i>
          </div>
        </div>
      </div>

      <!-- MAIN WEB MODULES TABS -->
      <div class="bg-slate-900 border border-slate-800 rounded-xl overflow-hidden shadow-xl">
        <div class="border-b border-slate-800 px-4 pt-3 flex flex-wrap gap-2 bg-slate-950">
          <button onclick="switchWebSubTab('carto')" id="webSubTab_carto" class="web-subtab-btn px-4 py-2.5 text-sm font-semibold border-b-2 border-emerald-500 text-emerald-400 flex items-center gap-2">
            <i class="fa-solid fa-map-location-dot"></i> Carte Cartographie & Suivi GPS
          </button>
          <button onclick="switchWebSubTab('incidents')" id="webSubTab_incidents" class="web-subtab-btn px-4 py-2.5 text-sm font-semibold border-b-2 border-transparent text-slate-400 hover:text-slate-200 flex items-center gap-2">
            <i class="fa-solid fa-list-check"></i> Gestion des Incidents & Alertes
          </button>
          <button onclick="switchWebSubTab('agents')" id="webSubTab_agents" class="web-subtab-btn px-4 py-2.5 text-sm font-semibold border-b-2 border-transparent text-slate-400 hover:text-slate-200 flex items-center gap-2">
            <i class="fa-solid fa-users-gear"></i> Effectifs ASP & Présence
          </button>
          <button onclick="switchWebSubTab('directives')" id="webSubTab_directives" class="web-subtab-btn px-4 py-2.5 text-sm font-semibold border-b-2 border-transparent text-slate-400 hover:text-slate-200 flex items-center gap-2">
            <i class="fa-solid fa-bullhorn"></i> Envoi Directives / Consignes
          </button>
          <button onclick="switchWebSubTab('partenaires')" id="webSubTab_partenaires" class="web-subtab-btn px-4 py-2.5 text-sm font-semibold border-b-2 border-transparent text-slate-400 hover:text-slate-200 flex items-center gap-2">
            <i class="fa-solid fa-handshake"></i> Partenaires & Indemnisations
          </button>
          <button onclick="switchWebSubTab('stats')" id="webSubTab_stats" class="web-subtab-btn px-4 py-2.5 text-sm font-semibold border-b-2 border-transparent text-slate-400 hover:text-slate-200 flex items-center gap-2">
            <i class="fa-solid fa-chart-pie"></i> Rapports & Analytics
          </button>
        </div>

        <div class="p-4 sm:p-6">

          <!-- 1. CARTO & MAP SECTION -->
          <div id="subTabContent_carto" class="space-y-4">
            <div class="flex flex-wrap items-center justify-between gap-4">
              <div>
                <h3 class="text-base font-bold text-slate-100">Supervision Nationale en Temps Réel</h3>
                <p class="text-xs text-slate-400">Positionnement des agents ASP (vert), incidents ouverts (rouge) et établissements sécurisés sur le territoire national.</p>
              </div>
              <div class="flex items-center gap-3 text-xs">
                <span class="flex items-center gap-1.5 bg-slate-800 px-2.5 py-1 rounded border border-slate-700">
                  <span class="w-3 h-3 rounded-full bg-emerald-500 inline-block"></span> Agent ASP Actif
                </span>
                <span class="flex items-center gap-1.5 bg-slate-800 px-2.5 py-1 rounded border border-slate-700">
                  <span class="w-3 h-3 rounded-full bg-red-500 inline-block animate-ping"></span> Alerte / Incident
                </span>
                <span class="flex items-center gap-1.5 bg-slate-800 px-2.5 py-1 rounded border border-slate-700">
                  <span class="w-3 h-3 rounded-full bg-blue-500 inline-block"></span> Établissement Scolaire / Quartier Sûr
                </span>
              </div>
            </div>
            
            <!-- Map Container -->
            <div id="mapSenegal" class="w-full h-[520px] rounded-xl border border-slate-800 shadow-inner z-10"></div>
          </div>

          <!-- 2. INCIDENTS TABLE SECTION -->
          <div id="subTabContent_incidents" class="hidden space-y-4">
            <div class="flex flex-wrap items-center justify-between gap-4">
              <h3 class="text-base font-bold text-slate-100">Registre National des Signalements & Incidents</h3>
              <div class="flex items-center gap-2">
                <select id="filterSeverity" onchange="filterIncidentsTable()" class="bg-slate-800 border border-slate-700 text-xs text-slate-200 rounded-lg px-3 py-2 focus:ring-1 focus:ring-emerald-500">
                  <option value="ALL">Toutes les gravités</option>
                  <option value="CRITIQUE">Critique / Urgent</option>
                  <option value="ELEVEE">Élevée</option>
                  <option value="MOYENNE">Moyenne</option>
                </select>
                <select id="filterStatus" onchange="filterIncidentsTable()" class="bg-slate-800 border border-slate-700 text-xs text-slate-200 rounded-lg px-3 py-2 focus:ring-1 focus:ring-emerald-500">
                  <option value="ALL">Tous les statuts</option>
                  <option value="EN_COURS">En cours de traitement</option>
                  <option value="RESOLU">Résolu</option>
                </select>
              </div>
            </div>

            <div class="overflow-x-auto rounded-lg border border-slate-800">
              <table class="w-full text-left text-xs text-slate-300">
                <thead class="bg-slate-950 text-slate-400 uppercase tracking-wider border-b border-slate-800">
                  <tr>
                    <th class="px-4 py-3">ID Incident</th>
                    <th class="px-4 py-3">Horodatage</th>
                    <th class="px-4 py-3">Département / Zone</th>
                    <th class="px-4 py-3">Catégorie</th>
                    <th class="px-4 py-3">Agent ASP Référent</th>
                    <th class="px-4 py-3">Gravité</th>
                    <th class="px-4 py-3">Statut</th>
                    <th class="px-4 py-3 text-right">Actions</th>
                  </tr>
                </thead>
                <tbody id="incidentsTableBody" class="divide-y divide-slate-800">
                  <!-- Dynamically Rendered -->
                </tbody>
              </table>
            </div>
          </div>

          <!-- 3. AGENTS & PRESENCE SECTION -->
          <div id="subTabContent_agents" class="hidden space-y-4">
            <div class="flex flex-wrap items-center justify-between gap-4">
              <div>
                <h3 class="text-base font-bold text-slate-100">Gestion des Effectifs & Suivi de Présence GPS</h3>
                <p class="text-xs text-slate-400">Pointeuse géographique et déploiement des agents de sécurité de proximité.</p>
              </div>
              <input type="text" id="searchAgentInput" onkeyup="filterAgentsTable()" placeholder="Rechercher agent ou CUD..." 
                     class="bg-slate-800 border border-slate-700 text-xs text-slate-200 rounded-lg px-3 py-2 w-64 focus:ring-emerald-500">
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-4">
              <div class="bg-slate-950 p-4 rounded-xl border border-slate-800 flex items-center gap-3">
                <div class="p-3 bg-emerald-500/10 text-emerald-400 rounded-lg"><i class="fa-solid fa-circle-check text-xl"></i></div>
                <div>
                  <p class="text-xs text-slate-400">Présence Validée GPS</p>
                  <p class="text-lg font-bold text-white">912 Agents</p>
                </div>
              </div>
              <div class="bg-slate-950 p-4 rounded-xl border border-slate-800 flex items-center gap-3">
                <div class="p-3 bg-amber-500/10 text-amber-400 rounded-lg"><i class="fa-solid fa-clock text-xl"></i></div>
                <div>
                  <p class="text-xs text-slate-400">Prise de Service En Attente</p>
                  <p class="text-lg font-bold text-white">70 Agents</p>
                </div>
              </div>
              <div class="bg-slate-950 p-4 rounded-xl border border-slate-800 flex items-center gap-3">
                <div class="p-3 bg-red-500/10 text-red-400 rounded-lg"><i class="fa-solid fa-user-xmark text-xl"></i></div>
                <div>
                  <p class="text-xs text-slate-400">Absences Signalées</p>
                  <p class="text-lg font-bold text-white">12 Agents</p>
                </div>
              </div>
            </div>

            <div class="overflow-x-auto rounded-lg border border-slate-800">
              <table class="w-full text-left text-xs text-slate-300">
                <thead class="bg-slate-950 text-slate-400 uppercase border-b border-slate-800">
                  <tr>
                    <th class="px-4 py-3">Matricule</th>
                    <th class="px-4 py-3">Nom & Prénom</th>
                    <th class="px-4 py-3">Pôle / Région</th>
                    <th class="px-4 py-3">Affectation (Quartier/École)</th>
                    <th class="px-4 py-3">Dernier Ping GPS</th>
                    <th class="px-4 py-3">Statut Présence</th>
                  </tr>
                </thead>
                <tbody id="agentsTableBody" class="divide-y divide-slate-800">
                  <!-- Dynamically populated -->
                </tbody>
              </table>
            </div>
          </div>

          <!-- 4. BROADCAST DIRECTIVES SECTION -->
          <div id="subTabContent_directives" class="hidden space-y-6">
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
              
              <!-- Form to Send Broadcast -->
              <div class="bg-slate-950 p-5 rounded-xl border border-slate-800 space-y-4">
                <h3 class="text-sm font-bold text-slate-100 flex items-center gap-2">
                  <i class="fa-solid fa-paper-plane text-emerald-400"></i> Émettre une Directive / Consigne
                </h3>
                <p class="text-xs text-slate-400">Diffuser des ordres de mission ou consignes de sécurité instantanément vers les terminaux mobiles des agents ASP sur le terrain.</p>
                
                <form id="directiveForm" onsubmit="handleSendDirective(event)" class="space-y-3">
                  <div>
                    <label class="block text-xs font-semibold text-slate-300 mb-1">Cible de la diffusion</label>
                    <select id="dirTarget" class="w-full bg-slate-900 border border-slate-700 text-xs rounded-lg px-3 py-2 text-slate-200 focus:ring-emerald-500">
                      <option value="TOUS">Tous les agents du Sénégal (Global)</option>
                      <option value="Dakar">Pôle Dakar & Banlieue</option>
                      <option value="Thiès">Pôle Thiès / Mbour</option>
                      <option value="Saint-Louis">Pôle Nord (Saint-Louis)</option>
                      <option value="Ziguinchor">Pôle Sud (Casamance)</option>
                    </select>
                  </div>

                  <div>
                    <label class="block text-xs font-semibold text-slate-300 mb-1">Titre de la Consigne</label>
                    <input type="text" id="dirTitle" required placeholder="Ex: Renforcement surveillance Établissements Scolaires" 
                           class="w-full bg-slate-900 border border-slate-700 text-xs rounded-lg px-3 py-2 text-slate-200 focus:ring-emerald-500">
                  </div>

                  <div>
                    <label class="block text-xs font-semibold text-slate-300 mb-1">Priorité</label>
                    <select id="dirPriority" class="w-full bg-slate-900 border border-slate-700 text-xs rounded-lg px-3 py-2 text-slate-200 focus:ring-emerald-500">
                      <option value="NORMALE">Normale</option>
                      <option value="HAUTE">Haute / Vigilance</option>
                      <option value="URGENTE">Urgent - Action Immédiate</option>
                    </select>
                  </div>

                  <div>
                    <label class="block text-xs font-semibold text-slate-300 mb-1">Détails des Directives</label>
                    <textarea id="dirContent" rows="4" required placeholder="Saisir les consignes précises à exécuter sur le terrain..." 
                              class="w-full bg-slate-900 border border-slate-700 text-xs rounded-lg px-3 py-2 text-slate-200 focus:ring-emerald-500"></textarea>
                  </div>

                  <button type="submit" class="w-full py-2.5 bg-emerald-600 hover:bg-emerald-500 text-white font-semibold text-xs rounded-lg shadow-md transition flex items-center justify-center gap-2">
                    <i class="fa-solid fa-broadcast-tower"></i> Diffuser la directive
                  </button>
                </form>
              </div>

              <!-- Directive Broadcast History -->
              <div class="lg:col-span-2 space-y-4">
                <h3 class="text-sm font-bold text-slate-100">Historique des Directives Envoyées</h3>
                <div id="directivesHistoryList" class="space-y-3">
                  <!-- Dynamic directives -->
                </div>
              </div>

            </div>
          </div>

          <!-- 5. PARTNERS & INDEMNIFICATIONS SECTION -->
          <div id="subTabContent_partenaires" class="hidden space-y-6">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
              
              <!-- Institutional Partners -->
              <div class="bg-slate-950 p-5 rounded-xl border border-slate-800 space-y-4">
                <div class="flex justify-between items-center">
                  <h3 class="text-sm font-bold text-slate-100 flex items-center gap-2">
                    <i class="fa-solid fa-handshake-angle text-emerald-400"></i> Partenaires Institutionnels & Sécurité
                  </h3>
                  <span class="text-xs text-slate-400">Coordination Multi-acteurs</span>
                </div>
                <div class="space-y-3" id="partnersListContainer">
                  <!-- Populated dynamically -->
                </div>
              </div>

              <!-- Indemnifications & Benefits Tracking -->
              <div class="bg-slate-950 p-5 rounded-xl border border-slate-800 space-y-4">
                <div class="flex justify-between items-center">
                  <h3 class="text-sm font-bold text-slate-100 flex items-center gap-2">
                    <i class="fa-solid fa-wallet text-amber-400"></i> Suivi des Indemnisations & Précisions
                  </h3>
                  <span class="px-2 py-0.5 rounded text-[10px] bg-emerald-500/20 text-emerald-300 border border-emerald-500/30">Mois en cours</span>
                </div>
                <p class="text-xs text-slate-400">Traçabilité des pécules et indemnisations mensuelles attribuées aux agents ASP.</p>

                <div class="space-y-3" id="indemnitiesListContainer">
                  <!-- Populated dynamically -->
                </div>
              </div>

            </div>
          </div>

          <!-- 6. STATS & ANALYTICS SECTION -->
          <div id="subTabContent_stats" class="hidden space-y-6">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div class="bg-slate-950 p-4 rounded-xl border border-slate-800">
                <h4 class="text-xs font-bold text-slate-300 uppercase mb-4">Répartition des Incidents par Pôle Régional</h4>
                <div class="relative h-64">
                  <canvas id="chartIncidentsRegion"></canvas>
                </div>
